#!/usr/bin/env python3
"""obsidian-vault-setup — make a folder an Obsidian vault and give it your plugin roster,
using only Obsidian's own surfaces. Source: ~/dev/obsidian-vault-setup (see README.md).

Every write goes through the official Obsidian CLI talking to the running app. This program never
opens, writes or copies a file under `.obsidian/` and never edits obsidian.json (it reads them in
`scan` only). Obsidian, BRAT and each plugin write their own files.

Commands:
  open  [<folder>] [--profile p] [--launch] [--notify]   open the vault at the folder's git root, or create it
  new   [<folder>] [--profile p] [--extra id ...]        make a vault: install the whole roster, enable the profile's set
  apply <vault> --profile p [--roster] [--register]      bring an existing vault to a profile (idempotent)
  plan  <vault> --profile p                              dry run
  scan                                                   read-only: every registered vault's plugins + pre-flight findings
  forget <folder>                                        unregister a closed vault (files untouched)
  doctor [<folder>]                                      probe the CLI and every undocumented API; pre-flight a folder
  init-config                                            create the config from config.example.yaml
  install-finder-button                                  build ~/Applications/Open in Obsidian.app, which is also the
                                                         handler for obsidian-vault-setup://open?path=<encoded path> links
  url   [<folder>]                                       print that clickable link for a folder

Config (roster, profiles, always_on, settings, core_settings, bookmark_bases, excluded_files, snippets,
brat_auto_update, banned list), first found of:
  $OBSIDIAN_VAULT_SETUP_CONFIG, $XDG_CONFIG_HOME/obsidian-vault-setup/config.yaml (~/.config/...).
  Start from config.example.yaml: `obsidian-vault-setup init-config`.

UNDOCUMENTED APIs (convention: `undocumented-api-usage` skill). Each call site carries a
`UNDOCUMENTED-API(<id>)` comment; `doctor` probes them; README.md § "Undocumented APIs" is the registry.
  vault-open-ipc     electron.ipcRenderer.sendSync('vault-open', path, false)  — register + open a folder
  vault-remove-ipc   electron.ipcRenderer.sendSync('vault-remove', path)       — unregister (closed vault)
  plugin-settings    app.plugins.plugins[id].settings + saveSettings()          — plugin's own settings save
  plugin-settings-hook  a plugin's own save call named in the config (`settings_save`), for plugins
                                                                             that keep no `settings`/`saveSettings` pair (e.g. Window Title's setTemplate)
  brat-addplugin     BRAT betaPlugins.addPlugin(repo, …)                         — GitHub-only plugin install
  core-plugin-settings  app.internalPlugins.getPluginById(id).instance.options + saveData(options)
                                                                             — a core plugin's settings (e.g. Quick switcher)
Verified against Obsidian app 1.14.4 (installer 1.12.4) and BRAT 2.2.0, 2026-10-13.
"""
import argparse
import glob
import json
import os
import shutil
import subprocess
import sys
import time

import yaml

CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "obsidian-vault-setup")
MANIFEST = os.path.expanduser(os.environ.get("OBSIDIAN_VAULT_SETUP_CONFIG")
                              or os.environ.get("OBSIDIAN_PLUGIN_MANIFEST")      # older name, still honoured
                              or os.path.join(CONFIG_DIR, "config.yaml"))
SHARE_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))   # repo root, or Homebrew libexec
EXAMPLE_CONFIG = os.path.join(SHARE_DIR, "config.example.yaml")
FINDER_SCRIPT = os.path.join(SHARE_DIR, "finder", "open-in-obsidian.applescript")
FINDER_APP = os.path.expanduser("~/Applications/Open in Obsidian.app")
__version__ = "0.1.15"
VERIFIED_APP_VERSION = "1.14.4"   # the undocumented APIs below were last verified on this app version
OBSIDIAN_JSON = os.path.expanduser("~/Library/Application Support/obsidian/obsidian.json")
CLI = shutil.which("obsidian") or "/Applications/Obsidian.app/Contents/MacOS/obsidian"
HOME = os.path.expanduser("~")


def short(path):
    return path.replace(HOME, "~", 1)


_HOST_VAULT = []   # cached name of an open, responsive vault ([] = not probed yet, [None] = none found)


def host_vault():
    """Name of an open vault that answers the CLI quickly, used for calls that target no vault in particular.

    Without vault=, the CLI targets the registered vault that contains the working directory (and prints
    NOTHING, exit 0, when that vault is closed: ~/dev is a registered vault, Verified 2026-10-13); from "/"
    it targets the active window, and such bare calls were observed to hang >60 s and return nothing
    (2026-10-14, cause not isolated). Routing every global call through a named, probed vault avoids both.
    Candidates come from obsidian.json (read-only) entries marked open; first one answering in 8 s wins."""
    if _HOST_VAULT:
        return _HOST_VAULT[0]
    try:
        with open(OBSIDIAN_JSON) as f:
            entries = list(json.load(f).get("vaults", {}).values())
    except (OSError, json.JSONDecodeError):
        entries = []
    paths = [v["path"] for v in sorted(entries, key=lambda v: -v.get("ts", 0)) if v.get("open")]
    names = [os.path.basename(p) for p in paths]
    for name in dict.fromkeys(names):
        if names.count(name) > 1 and len({p for p in paths if os.path.basename(p) == name}) > 1:
            continue   # ambiguous vault name
        if cli("version", vault=name, timeout=8)[:1].isdigit():
            _HOST_VAULT.append(name)
            return name
    _HOST_VAULT.append(None)
    return None


def cli(*args, vault=None, timeout=60):
    """Run the Obsidian CLI from "/". It exits 0 even on errors, so callers read the text.
    Pass vault= whenever possible; vault-agnostic callers pass vault=host_vault()."""
    cmd = [CLI] + ([f"vault={vault}"] if vault else []) + list(args)
    try:
        result = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                timeout=timeout, cwd="/")
    except subprocess.TimeoutExpired:
        print(f"obsidian-vault-setup: `obsidian {' '.join(cmd[1:])[:80]}` timed out after {timeout}s "
              "(is Obsidian busy or showing a dialog?)", file=sys.stderr)
        return ""
    return (result.stdout + result.stderr).strip()


def cli_eval(code, vault, retries=2):
    """`obsidian eval`, with the CLI's `=> ` prefix stripped. The CLI intermittently answers an EMPTY line to
    eval (observed 2026-10-19: 2 of 6 probes on one vault, 1 of 6 on another, while the value had in fact
    been set), so an empty reply is retried after a second, up to `retries` times, before it is returned
    and a caller files it as a hand-off."""
    # `vault=` is not honoured by eval (README gotcha, Observed 2026-10-20): the code runs in the FRONTMOST
    # window. So every eval first checks the window's vault name and answers 'WRONG VAULT <name>' instead of
    # writing into whatever window the person switched to; callers file that as a hand-off.
    if vault:
        code = "(app.vault.getName()!==%s ? 'WRONG VAULT '+app.vault.getName() : (%s))" % (json.dumps(vault), code)
    for attempt in range(retries + 1):
        out = cli("eval", f"code={code}", vault=vault)
        if out or attempt == retries:
            return out[3:].strip() if out.startswith("=> ") else out
        time.sleep(1)
    return ""


def load_manifest():
    if not os.path.exists(MANIFEST):
        sys.exit(f"No config at {short(MANIFEST)}. Create one from the example: obsidian-vault-setup init-config")
    with open(MANIFEST) as f:
        return yaml.safe_load(f)


def obsidian_running():
    return subprocess.run(["pgrep", "-x", "Obsidian"], capture_output=True).returncode == 0


def registered_vaults():
    """name -> set of paths, as the CLI resolves vault=<name>."""
    names = {}
    for line in cli("vaults", "verbose", vault=host_vault(), timeout=20).splitlines():
        if "\t" in line:
            name, path = line.split("\t", 1)
            names.setdefault(name, set()).add(path)
    return names


def installed_plugins(vault):
    out = cli("plugins", "filter=community", "versions", "format=json", vault=vault)
    try:
        return {p["id"]: p.get("version") for p in json.loads(out)}
    except json.JSONDecodeError:
        return {}


def enabled_plugins(vault):
    out = cli("plugins:enabled", "filter=community", vault=vault)
    return {line.split("\t")[0] for line in out.splitlines() if line.strip()}


def plugin_info(vault, plugin_id):
    info = {}
    for line in cli("plugin", f"id={plugin_id}", vault=vault).splitlines():
        if "\t" in line:
            key, value = line.split("\t", 1)
            info[key] = value
    return info


# ---------------------------------------------------------------------------------- scan

def cmd_scan(_args):
    """Read-only: every registered vault, its enabled and installed community plugins."""
    with open(OBSIDIAN_JSON) as f:
        config = json.load(f)
    paths = sorted({v["path"] for v in config["vaults"].values()})
    banned = set(load_manifest().get("banned", {}))
    for path in paths:
        config_dir = os.path.join(path, ".obsidian")
        try:
            with open(os.path.join(config_dir, "community-plugins.json")) as f:
                enabled = json.load(f)
        except (OSError, json.JSONDecodeError):
            enabled = []
        installed = {}
        for manifest_path in glob.glob(os.path.join(config_dir, "plugins", "*", "manifest.json")):
            with open(manifest_path) as f:
                m = json.load(f)
            installed[m["id"]] = (m.get("version"), m.get("author"))
        findings = preflight(path, budget=PREFLIGHT_BUDGET) if os.path.isdir(path) else []
        if not installed and not findings:
            continue
        print(f"\n{short(path)}")
        for line in findings:
            print(f"  WARN: {line}")
        for plugin_id, (version, author) in sorted(installed.items()):
            state = "on " if plugin_id in enabled else "off"
            flag = "  <-- BANNED" if plugin_id in banned and plugin_id in enabled else ""
            print(f"  {state} {plugin_id:32} {version:10} {author}{flag}")


# ----------------------------------------------------------------------------- plan/apply

def plugins_to_enable(manifest, profile, extras=()):
    """The plugins a vault of this profile gets switched ON: the config's `always_on` list (every vault,
    whatever the profile), then the profile's own list, then the run's `--extra` ids. Validated against the
    banned list and the plugin table; order kept, duplicates dropped."""
    profiles = manifest["profiles"]
    if profile not in profiles:
        sys.exit(f"Unknown profile {profile!r}. Profiles: {', '.join(profiles)}")
    wanted = list(dict.fromkeys(list(manifest.get("always_on") or []) + list(profiles[profile]["plugins"])
                                + list(extras or [])))
    banned = manifest.get("banned", {})
    for plugin_id in wanted:
        if plugin_id in banned:
            sys.exit(f"REFUSED: {plugin_id} is banned: {banned[plugin_id]['reason'].strip()}")
        if plugin_id not in manifest["plugins"]:
            sys.exit(f"{plugin_id} is not in the config. Add it to {short(MANIFEST)} first.")
    return wanted


def resolve(args, manifest):
    return plugins_to_enable(manifest, args.profile, args.extra or [])


def cmd_plan(args):
    manifest = load_manifest()
    wanted = resolve(args, manifest)
    path = os.path.abspath(os.path.expanduser(args.vault))
    print(f"Vault {short(path)} -> profile {args.profile}")
    print(f"  name the CLI will use: {os.path.basename(path)}")
    if wanted:
        print("  plugins:restrict off")
    for plugin_id in wanted:
        p = manifest["plugins"][plugin_id]
        how = ("plugin:install id=%s enable" % plugin_id) if p["source"] == "directory" \
            else f"HAND-OFF: not the directory plugin; install {p['repo']} (see skill section 5)"
        always = " (always_on)" if plugin_id in (manifest.get("always_on") or []) else ""
        print(f"  {plugin_id:30} {how}; expect author {p['expected_author']}{always}")
        for key, value in (p.get("settings") or {}).items():
            print(f"      setting {key} = {value!r}")
        if p.get("settings_save"):
            print(f"      saved by the plugin's own call: {p['settings_save'].strip()}")
    for plugin_id, settings in core_settings_for(manifest, args.profile).items():
        for key, value in settings.items():
            print(f"  core plugin {plugin_id:19} setting {key} = {value!r}")
    if bookmark_bases_for(manifest, args.profile):
        missing = missing_base_bookmarks(path) if os.path.isdir(path) else []
        print(f"  bookmark Bases: {', '.join(rel for rel, _ in missing) if missing else 'none missing'}")


def wait_for_install(vault, plugin_id, seconds=90):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if plugin_id in installed_plugins(vault):
            return True
        time.sleep(3)
    return False


def settings_code(plugin_id, settings, save_hook=None):
    """The JavaScript `obsidian eval` runs to save a plugin's settings, built here so tests can read it.
    Default: merge into the plugin's `settings` and call its `saveSettings()`. With `save_hook` (the config's
    `settings_save`), that snippet runs instead with `p` (the loaded plugin) and `s` (the settings) in scope
    and must `return` a string starting with 'OK ' on success."""
    payload = json.dumps(settings)
    head = "(async()=>{const p=app.plugins.plugins[%s]; if(!p) return 'NOT LOADED';" % json.dumps(plugin_id)
    if save_hook:
        # UNDOCUMENTED-API(plugin-settings-hook): the plugin's own save call, named per plugin in the config
        # (`settings_save`). For plugins that keep no `settings` + `saveSettings()` pair, e.g. Window Title 0.1.1:
        # `p.setTemplate(s.template); p.flushSave()` writes its data.json. Breaks as: TypeError (method renamed),
        # or the hook returns something other than 'OK …'. Fallback: Settings -> Community plugins -> <plugin>.
        return head + " const s=%s; %s })()" % (payload, save_hook.strip())
    # UNDOCUMENTED-API(plugin-settings): `app.plugins.plugins[id]` and the plugin's own `settings` object +
    # `saveSettings()`. Conventional for Obsidian plugins (sample-plugin pattern), not a public contract.
    # Breaks as: 'NOT LOADED' / 'NO saveSettings', or the value reverts after reload.
    # Fallback: the user sets it in Settings -> Community plugins -> <plugin>.
    return head + (
        " if(typeof p.saveSettings!=='function') return 'NO saveSettings';"
        " const merge=(t,s)=>{for(const k in s){if(s[k]&&typeof s[k]==='object'&&!Array.isArray(s[k]))"
        "{t[k]=t[k]||{};merge(t[k],s[k])}else t[k]=s[k]}}; merge(p.settings,%s); await p.saveSettings();"
        " if(typeof p.refreshAfterSettingsChange==='function') p.refreshAfterSettingsChange();"
        " return 'OK '+JSON.stringify(Object.fromEntries(Object.keys(%s).map(k=>[k,p.settings[k]])))})()"
    ) % (payload, payload)


def apply_settings(vault, plugin_id, settings, save_hook=None):
    return cli_eval(settings_code(plugin_id, settings, save_hook), vault)


def core_settings_for(manifest, profile):
    """Settings for Obsidian CORE plugins (Settings -> Core plugins), keyed by core plugin id (`switcher`,
    `file-explorer`, …). The top-level `core_settings` block applies to every vault the tool sets up; a
    profile's own `core_settings` block adds to or overrides it key by key. Returns {plugin_id: {key: value}}."""
    merged = {}
    for block in (manifest.get("core_settings") or {}, (manifest["profiles"].get(profile) or {}).get("core_settings") or {}):
        for plugin_id, settings in block.items():
            merged.setdefault(plugin_id, {}).update(settings or {})
    return merged


BASE_PRUNE = {"node_modules", "zArchive", "vendor", "Library", "templates"}   # a .base under templates/ is a template, not a Base


def bookmark_bases_for(manifest, profile):
    """True when this vault's Bases (*.base files) are to be bookmarked: the top-level `bookmark_bases`
    (default false), overridden by the profile's own `bookmark_bases` when present."""
    value = manifest.get("bookmark_bases", False)
    prof = (manifest["profiles"].get(profile) or {})
    if "bookmark_bases" in prof:
        value = prof["bookmark_bases"]
    return bool(value)


def bases_in(vault_path, max_depth=6):
    """Vault-relative paths of every Obsidian Base under the vault: a `*.base` file whose first 4 KB
    contain `views:` (a Dockerfile.base is not a Base). Dot-folders and BASE_PRUNE folders are skipped.
    Sorted by path. Reads only; nothing under .obsidian/ is touched."""
    found = []
    root_depth = vault_path.rstrip("/").count("/")
    for dirpath, dirnames, filenames in os.walk(vault_path):
        if dirpath.count("/") - root_depth >= max_depth:
            dirnames[:] = []
        dirnames[:] = sorted(d for d in dirnames if not d.startswith(".") and d not in BASE_PRUNE)
        for f in filenames:
            if f.endswith(".base"):
                full = os.path.join(dirpath, f)
                try:
                    with open(full, "r", encoding="utf-8", errors="replace") as fh:
                        head = fh.read(4096)
                except OSError:
                    continue
                if "views:" in head:
                    found.append(os.path.relpath(full, vault_path))
    return sorted(found)


def base_title(rel, all_rels):
    """Bookmark title for a Base: `Base · <stem>` (leading underscore and .base dropped). When two Bases in
    the vault share a stem, the shortest trailing part of the folder path that tells them apart is added:
    `dev-docs/decisions/_decisions.base` and `plugin/templates/decisions/_decisions.base` become
    `Base · dev-docs/decisions` and `Base · templates/decisions` (a folder named like the stem stands in for it;
    otherwise `Base · <folders>/<stem>`). Verified need: watchbill vault, 2026-10-19."""
    def stem_of(r):
        return os.path.basename(r)[:-len(".base")].lstrip("_")
    stem = stem_of(rel)
    rivals = [r for r in all_rels if r != rel and stem_of(r) == stem]
    if not rivals:
        return f"Base · {stem}"
    parts = os.path.dirname(rel).split("/") if os.path.dirname(rel) else []
    rival_dirs = [os.path.dirname(r).split("/") if os.path.dirname(r) else [] for r in rivals]
    n = 1
    while n <= len(parts) and any(rd[-n:] == parts[-n:] for rd in rival_dirs):
        n += 1
    suffix = parts[-n:] if parts else []
    if suffix and suffix[-1] == stem:
        return "Base · " + "/".join(suffix)
    return "Base · " + "/".join(suffix + [stem]) if suffix else f"Base · {stem}"


def bookmarked_paths(vault_path):
    """Paths already bookmarked in the vault, read (never written) from .obsidian/bookmarks.json; Obsidian
    nests bookmark groups, so walk `items` recursively. Missing or unreadable file: empty set."""
    def walk(items, out):
        for it in items or []:
            if isinstance(it, dict):
                if it.get("type") == "file" and it.get("path"):
                    out.add(it["path"])
                walk(it.get("items"), out)
        return out
    try:
        with open(os.path.join(vault_path, ".obsidian", "bookmarks.json"), encoding="utf-8") as f:
            return walk(json.load(f).get("items"), set())
    except (OSError, ValueError):
        return set()


def missing_base_bookmarks(vault_path):
    """[(rel, title)] for every Base in the vault that has no bookmark yet."""
    rels = bases_in(vault_path)
    have = bookmarked_paths(vault_path)
    return [(rel, base_title(rel, rels)) for rel in rels if rel not in have]


def bookmark_bases(vault_name, vault_path):
    """Bookmark every unbookmarked Base through the Obsidian CLI (`bookmark file=<path> title=<t>`, a
    documented command; Obsidian writes bookmarks.json). Returns report lines."""
    lines = []
    for rel, title in missing_base_bookmarks(vault_path):
        out = cli("bookmark", f"file={rel}", f"title={title}", vault=vault_name).strip()
        lines.append(f"bookmarked {rel} as {title!r}" if out.startswith("Bookmarked") else f"bookmark {rel}: {out or 'no answer'}")
    return lines


def compile_exclude(entry):
    """One `excluded_files` entry -> the string Obsidian stores in `userIgnoreFilters` (Settings -> Files and
    links -> Excluded files). `/…/` is a regular expression and is passed as written; an entry with a `/` in it
    is a vault-relative path prefix and is passed as written; a bare name (`node_modules`) means "a folder of
    this name at any depth" and becomes the regex `/(^|\\/)node_modules\\//`."""
    entry = str(entry).strip()
    if len(entry) > 1 and entry.startswith("/") and entry.endswith("/"):
        return entry
    if "/" in entry:
        return entry
    escaped = "".join("\\" + c if c in "\\^$.|?*+()[]{}" else c for c in entry)
    return "/(^|\\/)" + escaped + "\\//"


def brat_auto_update_for(manifest):
    """True (the default) when BRAT stays switched ON, with update-at-startup, in every vault that has a plugin
    installed through BRAT, so John's GitHub plugins (the Track Changes fork, Base Bookmarks) update themselves.
    `brat_auto_update: false` at the top of the config restores the pre-0.1.12 behaviour (BRAT switched off again
    after an install). John, 2026-10-28, on BRAT left on with update-at-startup: "This sounds good." (D11 of the
    Base Bookmarks design); confirmed 2026-10-29 on the obsidian-vault-lifecycle card, "yes, just do it"."""
    return bool(manifest.get("brat_auto_update", True))


def brat_plugins_present(manifest, vault_name, vault_path):
    """True when a plugin the config installs through BRAT is in this vault, or BRAT's own list names any repo
    (read, never written, from .obsidian/plugins/obsidian42-brat/data.json)."""
    installed = installed_plugins(vault_name)
    if any(p.get("install") == "brat" and pid in installed for pid, p in manifest["plugins"].items()):
        return True
    try:
        with open(os.path.join(vault_path, ".obsidian", "plugins", "obsidian42-brat", "data.json"), encoding="utf-8") as f:
            return bool(json.load(f).get("pluginList"))
    except (OSError, ValueError):
        return False


def snippets_for(manifest, profile):
    """CSS snippets a vault of this profile gets: the top-level `snippets` list (every vault) plus the profile's
    own, merged by name, the later entry winning. An entry is a name or {name, file, enabled}; `file` is relative
    to the config file's folder (default `snippets/<name>.css`), `enabled` defaults to true."""
    merged = {}
    for entry in list(manifest.get("snippets") or []) + list((manifest["profiles"].get(profile) or {}).get("snippets") or []):
        if isinstance(entry, str):
            entry = {"name": entry}
        name = entry["name"]
        merged[name] = {"name": name, "file": entry.get("file") or f"snippets/{name}.css",
                        "enabled": bool(entry.get("enabled", True))}
    return list(merged.values())


def snippet_source(entry, manifest_path=None):
    """The snippet's CSS source on disk: `file` as given when absolute, else beside the config file (its real
    path, since the config is often a symlink into a repository)."""
    base = os.path.dirname(os.path.realpath(manifest_path or MANIFEST))
    return entry["file"] if os.path.isabs(entry["file"]) else os.path.join(base, entry["file"])


def snippet_code(name, css):
    """The JavaScript `obsidian eval` runs to put a CSS snippet into the vault, built here so tests can read it:
    writes `.obsidian/snippets/<name>.css` through Obsidian's own file adapter when no file of that name exists
    (an existing one is John's or another tool's and is left as it is), then asks Obsidian to re-read its
    snippet list. Enabling is the CLI's `snippet:enable`."""
    # UNDOCUMENTED-API(snippets-adapter): `app.vault.adapter.exists/mkdir/write` (the adapter every plugin uses
    # for config-dir files) and `app.customCss.requestLoadSnippets()`, which the Appearance pane calls to re-read
    # `.obsidian/snippets/`. Breaks as: TypeError on requestLoadSnippets, or the snippet missing from Settings ->
    # Appearance -> CSS snippets after the run. Fallback: copy the .css into .obsidian/snippets/ by hand and switch
    # it on in Settings -> Appearance.
    return ("(async()=>{const dir=app.vault.configDir+'/snippets'; const path=dir+'/'+%s+'.css';"
            " if(!(await app.vault.adapter.exists(dir))) await app.vault.adapter.mkdir(dir);"
            " const had=await app.vault.adapter.exists(path); if(!had) await app.vault.adapter.write(path,%s);"
            " if(app.customCss&&typeof app.customCss.requestLoadSnippets==='function') app.customCss.requestLoadSnippets();"
            " return 'OK '+JSON.stringify({written:!had})})()" % (json.dumps(name), json.dumps(css)))


def apply_snippet(vault, entry):
    """Install one snippet (see snippet_code) and, when the entry wants it, switch it on with `snippet:enable`.
    Returns a line starting with 'OK' on success."""
    source = snippet_source(entry)
    try:
        with open(source, encoding="utf-8") as f:
            css = f.read()
    except OSError as e:
        return f"NO SOURCE {short(source)} ({e.strerror})"
    result = cli_eval(snippet_code(entry["name"], css), vault)
    if not result.startswith("OK"):
        return result or "no reply from eval"
    if entry["enabled"]:
        time.sleep(1)
        out = cli("snippet:enable", f"name={entry['name']}", vault=vault)
        if "rror" in out or "not found" in out.lower():
            return f"written but not enabled: {out}"
    return result + (" enabled" if entry["enabled"] else " (left off)")


def excluded_files_for(manifest, profile):
    """Obsidian's Excluded files for a vault of this profile: the top-level `excluded_files` list (every vault)
    plus the profile's own, in order, compiled and de-duplicated."""
    entries = list(manifest.get("excluded_files") or []) + list((manifest["profiles"].get(profile) or {}).get("excluded_files") or [])
    return list(dict.fromkeys(compile_exclude(e) for e in entries))


def apply_excluded_files(vault, filters):
    """Add `filters` to the vault's Excluded files, keeping whatever is already there (idempotent)."""
    # UNDOCUMENTED-API(excluded-files): `app.vault.getConfig('userIgnoreFilters')` is the array the Settings pane
    # (Files and links -> Excluded files) edits, null until first set; `app.vault.setConfig(key, value)` is what
    # the pane calls to persist it (-> `.obsidian/app.json`, written by Obsidian) and it fires `config-changed`,
    # which the metadata cache listens to (`app.metadataCache.userIgnoreFilters` follows). Verified app 1.14.4,
    # 2026-10-26, throwaway vault: app.json gained the entries, search/graph hid a matching folder.
    # Breaks as: 'NO setConfig', or `.obsidian/app.json` without `userIgnoreFilters` after the call.
    # Fallback: Settings -> Files and links -> Excluded files -> Manage, one entry per line.
    payload = json.dumps(filters)
    code = (
        "(()=>{if(typeof app.vault.setConfig!=='function'||typeof app.vault.getConfig!=='function') return 'NO setConfig';"
        " const want=%s; const cur=app.vault.getConfig('userIgnoreFilters'); const list=Array.isArray(cur)?cur.slice():[];"
        " const added=want.filter(w=>!list.includes(w)); if(added.length) app.vault.setConfig('userIgnoreFilters',list.concat(added));"
        " const now=app.vault.getConfig('userIgnoreFilters')||[];"
        " return 'OK '+JSON.stringify({added:added.length,total:now.length,cache:(app.metadataCache.userIgnoreFilters||[]).length})})()"
    ) % payload
    return cli_eval(code, vault)


PREFLIGHT_PRUNE = {".git"}   # Obsidian does not index .git; skipping it keeps the walk fast
PREFLIGHT_BUDGET = 15        # seconds new/open/apply spend on the walk before handing the rest to `doctor <folder>`


def preflight(vault_path, budget=None):
    """Read-only walk of a vault folder. Returns one line per thing that makes Obsidian fail to load the vault
    or index what it should not: a directory the current user cannot read (Obsidian aborts the vault with
    EACCES), and a symlink whose target is outside the vault (Obsidian follows it, e.g. a committed symlink
    to /tmp walked /private/tmp into a root-owned folder, 2026-10-26). Does not follow symlinks itself.
    With `budget` (seconds) the walk stops early and the last line says so: a big monorepo vault takes minutes."""
    root = os.path.realpath(vault_path)
    findings = []
    deadline = time.monotonic() + budget if budget else None
    def rel(path):
        return os.path.relpath(path, vault_path)
    def on_error(err):
        if isinstance(err, PermissionError):
            findings.append(f"unreadable directory: {rel(err.filename)}")
    for dirpath, dirnames, filenames in os.walk(vault_path, onerror=on_error, followlinks=False):
        if deadline and time.monotonic() > deadline:
            findings.append(f"pre-flight stopped after {budget} s at {rel(dirpath)}; run `obsidian-vault-setup doctor {short(vault_path)}` for the full walk")
            break
        dirnames[:] = [d for d in dirnames if d not in PREFLIGHT_PRUNE]
        for name in dirnames + filenames:
            full = os.path.join(dirpath, name)
            if os.path.islink(full):
                target = os.path.realpath(full)
                if target != root and not target.startswith(root + os.sep):
                    findings.append(f"symlink outside vault: {rel(full)} -> {os.readlink(full)}")
    return findings


def print_preflight(vault_path):
    findings = preflight(vault_path, budget=PREFLIGHT_BUDGET)
    for line in findings:
        print(f"  WARN: {line}")
    return findings


def apply_core_settings(vault, plugin_id, settings):
    # UNDOCUMENTED-API(core-plugin-settings): `app.internalPlugins.getPluginById(id)` returns the core plugin;
    # its `instance.options` is the settings object the Settings pane edits, and `saveData(options)` is what
    # the pane calls to persist it (vault.writeConfigJson(id, options) -> `.obsidian/<id>.json`, written by
    # Obsidian). `saveData()` with NO argument writes nothing. Works whether or not the core plugin is
    # enabled. Verified app 1.14.4, 2026-10-19, `switcher.showAllFileTypes` on five vaults.
    # Breaks as: 'NO CORE PLUGIN <id>' / 'NO saveData', or `.obsidian/<id>.json` unchanged after the call.
    # Fallback: the user flips it in Settings -> <core plugin>.
    payload = json.dumps(settings)
    code = (
        "(async()=>{const p=app.internalPlugins.getPluginById(%s); if(!p) return 'NO CORE PLUGIN '+%s;"
        " if(typeof p.saveData!=='function'||!p.instance||typeof p.instance.options!=='object') return 'NO saveData';"
        " Object.assign(p.instance.options,%s); await p.saveData(p.instance.options);"
        " return 'OK '+JSON.stringify(Object.fromEntries(Object.keys(%s).map(k=>[k,p.instance.options[k]])))})()"
    ) % (json.dumps(plugin_id), json.dumps(plugin_id), payload, payload)
    return cli_eval(code, vault)


def gui_announce(message):
    """When run by an AI agent (CLAUDE_SESSION_ID set) and a `gui-takeover` helper exists, announce the new
    window before it appears. Optional; a person running the command gets no banner."""
    if os.environ.get("CLAUDE_SESSION_ID") and shutil.which("gui-takeover") and not os.environ.get("GUI_TAKEOVER_OFF"):
        try:
            subprocess.run(["gui-takeover", "5", message], stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        except subprocess.TimeoutExpired:
            pass


def register_vault(path, name):
    vaults = registered_vaults()
    host = host_vault()
    gui_announce(f"Opening {short(path)} as a new Obsidian vault (one new window, no clicks)")
    # UNDOCUMENTED-API(vault-open-ipc): the main-process IPC the vault switcher's "Open folder as vault"
    # button sends. Found by reading obsidian-<ver>.asar (ipcMain.on("vault-open",(e,path,create)=>…)).
    # Breaks as: eval prints an error or `false`, vault never appears in `obsidian vaults`.
    # Fallback: vault switcher -> Open folder as vault, then re-run `apply`.
    result = cli_eval("electron.ipcRenderer.sendSync('vault-open', %s, false)" % json.dumps(path), host)
    for _ in range(10):
        time.sleep(2)
        if path in registered_vaults().get(name, set()) and "Vault not found" not in cli("vault", vault=name):
            return None
    return f"registration failed (vault-open returned {result!r})"


brat_switched_on = [False]


def brat_registered(vault_path, repo):
    """True when BRAT's own list in this vault names `repo` (read, never written, from
    .obsidian/plugins/obsidian42-brat/data.json). A plugin marked `install: brat` whose id is already in the vault
    but whose repo BRAT does not know came from the community directory (or by hand), not from the fork."""
    try:
        with open(os.path.join(vault_path, ".obsidian", "plugins", "obsidian42-brat", "data.json"), encoding="utf-8") as f:
            return repo in (json.load(f).get("pluginList") or [])
    except (OSError, ValueError):
        return False


def brat_install(vault, repo, plugin_id=None, reinstall=False):
    """Install a GitHub plugin with BRAT's own addPlugin(), inside the app. BRAT is switched on for the call
    and, since 0.1.12, left on (setup() sets update-at-startup) unless the config says brat_auto_update: false. With
    `reinstall`, the plugin id is already in the vault from somewhere else (the community directory): BRAT
    replaces its files and the call waits for the installed manifest version to change."""
    before = installed_plugins(vault).get(plugin_id) if plugin_id else None
    if "obsidian42-brat" not in installed_plugins(vault):
        cli("plugin:install", "id=obsidian42-brat", vault=vault, timeout=180)
        if not wait_for_install(vault, "obsidian42-brat"):
            return "BRAT did not install"
    if "obsidian42-brat" not in enabled_plugins(vault):
        cli("plugin:enable", "id=obsidian42-brat", vault=vault)
        brat_switched_on[0] = True
        time.sleep(2)
    # UNDOCUMENTED-API(brat-addplugin): BRAT's internal BetaPlugins.addPlugin(repo, updatePluginFiles,
    # seeIfUpdatedOnly, reportIfNotUpdated, specifyVersion, forceReinstall, enableAfterInstall). Read from
    # BRAT 2.2.0 main.js. Breaks as: 'BRAT not loaded', a TypeError, or the plugin never lands.
    # Fallback: open obsidian://brat?plugin=<owner/repo> and click Add Plugin.
    code = ("(async()=>{const b=app.plugins.plugins['obsidian42-brat']; if(!b) return 'BRAT not loaded';"
            " const ok=await b.betaPlugins.addPlugin(%s,false,false,false,'',%s,false); return String(ok)})()"
            % (json.dumps(repo), "true" if reinstall else "false"))
    result = cli_eval(code, vault)
    if result.strip() not in ("true", ""):
        return f"BRAT addPlugin returned {result!r}"
    if reinstall and plugin_id:
        deadline = time.time() + 90
        while time.time() < deadline:
            if installed_plugins(vault).get(plugin_id) != before:
                return None
            time.sleep(3)
        return f"BRAT did not replace {plugin_id} {before} within 90 s"
    return None


def setup(path, profile, extras, register, roster):
    manifest = load_manifest()
    to_enable = plugins_to_enable(manifest, profile, extras)
    banned = manifest.get("banned", {})
    to_install = list(dict.fromkeys(to_enable + ([k for k, v in manifest["plugins"].items()
                                                  if v.get("roster") and k not in banned] if roster else [])))
    name = os.path.basename(path)
    report, handoffs = [], []
    brat_switched_on[0] = False

    if not obsidian_running():
        sys.exit("Obsidian is not running. Open it first (agents do not launch or quit it).")
    if not os.path.isdir(path):
        sys.exit(f"{short(path)} is not a folder.")
    print_preflight(path)   # unreadable directories and symlinks out of the vault; Obsidian may refuse to load it
    vaults = registered_vaults()
    others = vaults.get(name, set()) - {path}
    if others:
        sys.exit(f"REFUSED: vault name {name!r} also points at {', '.join(map(short, others))}; "
                 "vault=<name> would be ambiguous. Remove one registration in Obsidian's vault switcher.")
    if path not in vaults.get(name, set()):
        if not register:
            sys.exit(f"{short(path)} is not a vault yet. Use `new` (or `apply --register`).")
        error = register_vault(path, name)
        if error:
            sys.exit(f"{error}. Fallback: Obsidian vault switcher -> Open folder as vault.")
        report.append(f"registered and opened {short(path)} as vault {name!r}")

    banned_on = enabled_plugins(name) & set(banned)
    if banned_on:
        sys.exit(f"REFUSED: banned plugin enabled in this vault: {', '.join(banned_on)}. "
                 "Disable it in Settings -> Community plugins first.")

    if to_install and cli("plugins:restrict", vault=name).strip() == "on":
        cli("plugins:restrict", "off", vault=name)
        time.sleep(3)
        report.append("Restricted mode: off")

    for plugin_id in to_install:
        p = manifest["plugins"][plugin_id]
        reloaded = False
        if p.get("install") == "brat" and plugin_id in installed_plugins(name) and not brat_registered(path, p["repo"]):
            # The id is in the vault but not from BRAT: the community-directory build (or an old copy) is
            # installed where the config wants the GitHub build (John, 2026-10-26: Track Changes must be his
            # fork). BRAT replaces the files; a loaded plugin keeps running the old build until it is reloaded.
            was_loaded = plugin_id in enabled_plugins(name)
            error = brat_install(name, p["repo"], plugin_id=plugin_id, reinstall=True)
            if error:
                handoffs.append(f"{plugin_id}: not replaced from {p['repo']} ({error})")
                continue
            if was_loaded:
                cli("plugin:disable", f"id={plugin_id}", vault=name)
                time.sleep(1)
                cli("plugin:enable", f"id={plugin_id}", vault=name)
                time.sleep(2)
                reloaded = True
            report.append(f"replaced {plugin_id} with {p['repo']} {installed_plugins(name).get(plugin_id)}"
                          + (" and reloaded it" if was_loaded else ""))
        if plugin_id not in installed_plugins(name):
            if p.get("install") == "brat":
                error = brat_install(name, p["repo"])
            elif p["source"] == "directory":
                cli("plugin:install", f"id={plugin_id}", vault=name, timeout=180)
                error = None
            else:
                error = f"no sanctioned install route for {p['repo']}"
            if error or not wait_for_install(name, plugin_id):
                handoffs.append(f"{plugin_id}: not installed ({error or 'did not land within 90 s'})")
                continue
            report.append(f"installed {plugin_id} {installed_plugins(name).get(plugin_id)}")
        author = plugin_info(name, plugin_id).get("author", "?")
        if author == "?":
            # The CLI gave no answer (busy, another vault answered, a transient): unknown is not a mismatch. Leave the
            # plugin as it is and say so. (0.1.15: a pass on 2026-10-30 switched Obsidian Git off in a vault on a
            # '?' read; the manifest.json said Vinzent all along.)
            handoffs.append(f"{plugin_id}: author not readable this run (manifest expects {p['expected_author']!r}); "
                            "left as it is, check with `obsidian plugin id=` later")
            continue
        if author != p["expected_author"]:
            handoffs.append(f"{plugin_id}: installed author is {author!r}, manifest expects "
                            f"{p['expected_author']!r}; switched off, decide by hand")
            cli("plugin:disable", f"id={plugin_id}", vault=name)
            continue
        wanted_on = plugin_id in to_enable
        was_on = plugin_id in enabled_plugins(name)
        if p.get("settings"):
            # The plugin saves its own settings, so it must be loaded: switch on, save, then restore.
            if not was_on:
                cli("plugin:enable", f"id={plugin_id}", vault=name)
                time.sleep(2)
            result = apply_settings(name, plugin_id, p["settings"], p.get("settings_save"))
            (report if result.startswith("OK") else handoffs).append(f"settings {plugin_id}: {result}")
            if not was_on and not wanted_on:
                cli("plugin:disable", f"id={plugin_id}", vault=name)
        if wanted_on and plugin_id not in enabled_plugins(name):
            cli("plugin:enable", f"id={plugin_id}", vault=name)
            report.append(f"enabled {plugin_id}")
    # Core-plugin settings (every vault, plus the profile's own): Obsidian writes `.obsidian/<id>.json` itself.
    for plugin_id, settings in core_settings_for(manifest, profile).items():
        result = apply_core_settings(name, plugin_id, settings)
        (report if result.startswith("OK") else handoffs).append(f"core settings {plugin_id}: {result}")
    # Excluded files (Settings -> Files and links), so build output and caches stay out of search and graph.
    excluded = excluded_files_for(manifest, profile)
    if excluded:
        result = apply_excluded_files(name, excluded)
        (report if result.startswith("OK") else handoffs).append(f"excluded files: {result}")
    # CSS snippets every vault gets (John, 2026-10-29, "yes, just do it" on the wide-snippet card of
    # obsidian-vault-lifecycle): written once through Obsidian's adapter, never over an existing file of that name.
    for entry in snippets_for(manifest, profile):
        result = apply_snippet(name, entry)
        (report if result.startswith("OK") else handoffs).append(f"snippet {entry['name']}: {result}")
    # Bases (*.base) bookmarked so each is one click away in the Bookmarks pane (John, 2026-10-19).
    if bookmark_bases_for(manifest, profile):
        for line in bookmark_bases(name, path):
            (report if line.startswith("bookmarked") else handoffs).append(line)
    # A watchbill system's home: watchbill writes the card-lane dropdown now that the vault is in front and Custom
    # Selectors is in (John, 2026-10-29, on the obsidian-vault-lifecycle card: "yes. on the obsidian setup").
    if "custom-selectors" in installed_plugins(name):
        line = watchbill_dropdown(path)
        if line:
            (report if line.startswith("OK") else handoffs).append(line)
    # BRAT stays ON, with update-at-startup, wherever a BRAT-installed plugin lives, so John's GitHub plugins
    # update themselves (brat_auto_update_for). Before 0.1.12 the tool switched BRAT off here, so BRAT's own
    # updateAtStartup never ran and the Track Changes fork stayed at the version it was installed with.
    if brat_auto_update_for(manifest) and brat_plugins_present(manifest, name, path):
        if "obsidian42-brat" not in enabled_plugins(name):
            cli("plugin:enable", "id=obsidian42-brat", vault=name)
            time.sleep(2)
        result = apply_settings(name, "obsidian42-brat", {"updateAtStartup": True})
        (report if result.startswith("OK") else handoffs).append(f"BRAT left on, update at startup: {result}")
    elif "obsidian42-brat" not in to_enable and brat_switched_on[0]:
        # Never switch off a plugin someone switched on: only BRAT, if this run switched it on.
        cli("plugin:disable", "id=obsidian42-brat", vault=name)
    time.sleep(3)
    enabled_now = enabled_plugins(name)
    installed_now = installed_plugins(name)
    print(f"Vault {short(path)} (profile {profile}{', full roster' if roster else ''})")
    for line in report:
        print(f"  done: {line}")
    print("  ON : " + ", ".join(sorted(enabled_now)))
    print("  off: " + ", ".join(sorted(set(installed_now) - enabled_now)))
    for line in handoffs:
        print(f"  HAND-OFF: {line}")
    if roster:
        print("  Toggle plugins in Obsidian: Settings -> Community plugins.")
    return 1 if handoffs else 0


def git_root(folder):
    result = subprocess.run(["git", "-C", folder, "rev-parse", "--show-toplevel"],
                            capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else folder


def notify(message):
    subprocess.run(["osascript", "-e", f"display notification {json.dumps(message)} with title \"Obsidian\""],
                   capture_output=True)


def wait_for_cli(seconds=40):
    deadline = time.time() + seconds
    while time.time() < deadline:
        _HOST_VAULT.clear()
        if obsidian_running() and host_vault():
            return True
        time.sleep(2)
    return False


def is_watchbill_home(path):
    """True when `path` is a registered watchbill system's home (`watchbill systems find` names it), or carries a
    system's decision board (`dev-docs/substantive/`). Every watchbill system is reviewed with Track Changes, so
    such a folder gets the review-repo profile unless a profile is named (a watchbill system's vault came up on
    core-only with Track Changes installed and off, susan-bones-performance-diagnostics, 2026-10-29; John: "have
    that system get fixed")."""
    if os.path.isdir(os.path.join(path, "dev-docs", "substantive")):
        return True
    if shutil.which("watchbill"):
        try:
            out = subprocess.run(["watchbill", "systems", "find", path], capture_output=True, text=True, timeout=20,
                                 cwd="/", stdin=subprocess.DEVNULL)
            return out.returncode == 0 and os.path.realpath(path) in out.stdout
        except (OSError, subprocess.TimeoutExpired):
            return False
    return False


def watchbill_system_name(path):
    """The registered watchbill system whose home is `path` (the first token of `watchbill systems find`'s row),
    or None when there is no watchbill CLI or no such system."""
    if not shutil.which("watchbill"):
        return None
    try:
        out = subprocess.run(["watchbill", "systems", "find", path], capture_output=True, text=True, timeout=20,
                             cwd="/", stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    real = os.path.realpath(path)
    for line in out.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2 and os.path.realpath(parts[-1]) == real:
            return parts[0]
    return None


def parse_dropdown_line(line):
    """Read `watchbill decisions dropdown`'s one stdout line (contract: watchbill dev-docs/contracts/decisions-dropdown.md;
    fixtures copied to tests/fixtures/decisions-dropdown/): returns (ok, result, text), where `result` is everything before
    the first ': ' (OK written | OK unchanged | OK rewritten | SKIP <reason>) and `ok` is True for an OK result."""
    line = (line or "").strip()
    if not line:
        return False, "", "no output"
    result, _, text = line.partition(": ")
    return result.startswith("OK"), result, text


def watchbill_dropdown(path):
    """Ask watchbill to write the card-lane dropdown (the Custom Selectors selector for `_human_verdict`, with
    watchbill's own lanes) into this vault, which the caller has just brought to the front. watchbill 0.10.84:
    `watchbill decisions dropdown <system>` writes only the plugin's settings, never the repository, and prints one
    line (OK written|unchanged|rewritten, or SKIP <reason>: WRONG VAULT, plugin not loaded, no answer, no CLI, not a
    vault). Returns a report line starting with 'OK' or a hand-off line; None when the folder is no watchbill home.
    The lanes are watchbill's vocabulary, so this tool never writes the selector itself (agreement with watchbill's
    architect, 2026-10-30, obsidian-vault-lifecycle dev-docs/runs/2026-10-29-brat-on-and-snippets/agreement-watchbill-dropdown.md)."""
    system = watchbill_system_name(path)
    if not system:
        if shutil.which("watchbill") and is_watchbill_home(path):
            return "card-lane dropdown: this folder is a watchbill home but `watchbill systems find` named no system for it this run; run `watchbill decisions dropdown <system>` by hand"
        return None
    try:
        out = subprocess.run(["watchbill", "decisions", "dropdown", system], capture_output=True, text=True,
                             timeout=120, cwd="/", stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"watchbill decisions dropdown {system}: did not run ({e.__class__.__name__})"
    if out.returncode != 0:
        return f"watchbill decisions dropdown {system}: exit {out.returncode} ({(out.stderr or out.stdout).strip()[:160]})"
    ok, result, text = parse_dropdown_line(out.stdout)
    return f"{result}: {text}" if ok else f"card-lane dropdown {result}: {text}"


WATCHBILL_HOME_PROFILES = ("watchbill-system", "review-repo")   # first one the config has wins (0.1.13: watchbill-system)


def default_profile_for(path, requested, manifest=None):
    """The profile `open` and `new` use when none is named: for a watchbill system's home, `watchbill-system`
    when the config has that profile (0.1.13: review-repo plus the plugins every watchbill board needs, such as
    Custom Selectors for the card's lane dropdown; John, 2026-10-29, on the obsidian-vault-lifecycle card), else
    `review-repo`; for any other folder core-only. A named profile always wins."""
    if requested:
        return requested
    manifest = manifest or load_manifest()
    if is_watchbill_home(path):
        for profile in WATCHBILL_HOME_PROFILES:
            if profile in manifest.get("profiles", {}):
                print(f"profile {profile}: {short(path)} is a watchbill system's home")
                return profile
    return "core-only"


def cmd_open(args):
    """Open the vault at the folder's git root (or the folder); create it if it is not a vault yet."""
    folder = os.path.abspath(os.path.expanduser(args.folder))
    root = git_root(folder)
    name = os.path.basename(root)
    if not obsidian_running():
        if not args.launch:
            sys.exit("Obsidian is not running. Open it first, or pass --launch.")
        subprocess.run(["open", "-a", "Obsidian"])
        if not wait_for_cli():
            sys.exit("Obsidian did not answer the CLI within 40 s.")
    if root in registered_vaults().get(name, set()):
        print_preflight(root)
        # Documented macOS path: Obsidian opens the registered vault that contains a folder it is handed.
        subprocess.run(["open", "-a", "Obsidian", root])
        message = f"Opened vault {name}"
        print(message)
        if args.notify:
            notify(message)
        return 0
    status = setup(root, default_profile_for(root, args.profile), [], register=True, roster=True)
    if args.notify:
        notify(f"Created vault {name}" + (" (see log: hand-offs)" if status else ""))
    return status


def cmd_doctor(args):
    """Probe the CLI and each undocumented API without changing anything; with a folder, pre-flight it too."""
    problems = 0
    def check(label, ok, detail=""):
        nonlocal problems
        problems += 0 if ok else 1
        print(f"  {'ok  ' if ok else 'FAIL'} {label}{(' — ' + detail) if detail else ''}")
    print(f"obsidian-vault-setup doctor (config {short(MANIFEST)})")
    check("config readable", os.path.exists(MANIFEST), "" if os.path.exists(MANIFEST) else "run: obsidian-vault-setup init-config")
    running = obsidian_running()
    check("Obsidian running", running, "" if running else "start Obsidian, then re-run")
    if not running:
        return 1
    host = host_vault()
    check("an open vault answers the CLI", bool(host), host or "open any vault in Obsidian")
    raw = cli("version", vault=host, timeout=15) if host else ""
    version = raw.split()[0] if raw else "?"
    check("CLI answers", version[:1].isdigit(), f"app {version}")
    check(f"app version is the verified {VERIFIED_APP_VERSION}", version == VERIFIED_APP_VERSION,
          "" if version == VERIFIED_APP_VERSION else "re-verify the UNDOCUMENTED-API sites, then bump VERIFIED_APP_VERSION")
    if not host:
        return 1
    # UNDOCUMENTED-API(vault-open-ipc / vault-remove-ipc): probe that the renderer can reach ipcRenderer and
    # that the main process still answers the sibling read-only channel 'vault-list'.
    probe = cli_eval("typeof electron.ipcRenderer.sendSync==='function' && "
                     "typeof electron.ipcRenderer.sendSync('vault-list')==='object' ? 'ok' : 'missing'", host)
    check("vault IPC reachable (vault-open / vault-remove)", probe == "ok", probe)
    # UNDOCUMENTED-API(plugin-settings): the plugin registry object exists.
    probe = cli_eval("typeof app.plugins.plugins==='object' && typeof app.plugins.enabledPlugins==='object' ? 'ok':'missing'", host)
    check("app.plugins registry", probe == "ok", probe)
    # UNDOCUMENTED-API(core-plugin-settings): the core-plugin registry answers and the switcher has saveData.
    probe = cli_eval("(()=>{const p=app.internalPlugins.getPluginById('switcher');"
                     " return p&&typeof p.saveData==='function'&&p.instance&&typeof p.instance.options==='object'?'ok':'missing'})()", host)
    check("core plugin registry + saveData (core-plugin-settings)", probe == "ok", probe)
    # UNDOCUMENTED-API(excluded-files): vault config get/set and the metadata cache's filter list exist.
    probe = cli_eval("(()=>{const c=app.vault.getConfig('userIgnoreFilters'); return typeof app.vault.setConfig==='function'"
                     "&&(c===null||c===undefined||Array.isArray(c))&&Array.isArray(app.metadataCache.userIgnoreFilters)?'ok':'missing'})()", host)
    check("vault config get/set + metadata cache filters (excluded-files)", probe == "ok", probe)
    check("brat-addplugin", True, "probed at use time (needs BRAT loaded in the target vault)")
    folder = getattr(args, "folder", None)
    if folder:
        folder = os.path.abspath(os.path.expanduser(folder))
        findings = preflight(folder) if os.path.isdir(folder) else [f"not a folder: {short(folder)}"]
        check(f"pre-flight {short(folder)}", not findings, "" if not findings else f"{len(findings)} finding(s)")
        for line in findings:
            print(f"       {line}")
    return 1 if problems else 0


def cmd_init_config(args):
    """Copy config.example.yaml to the config path (never overwrites)."""
    if os.path.exists(MANIFEST) and not args.force:
        print(f"Config already exists: {short(MANIFEST)} (use --force to replace it with the example)")
        return 0
    os.makedirs(os.path.dirname(MANIFEST), exist_ok=True)
    shutil.copyfile(EXAMPLE_CONFIG, MANIFEST)
    print(f"Wrote {short(MANIFEST)} from the example. Edit the roster, profiles and settings (e.g. your name).")
    return 0


URL_SCHEME = "obsidian-vault-setup"   # obsidian-vault-setup://open?path=<url-encoded absolute path>
LSREGISTER = ("/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework"
              "/Support/lsregister")


def open_url(folder):
    """The clickable form of `obsidian-vault-setup open <folder>`, handled by the Finder button app."""
    import urllib.parse
    return f"{URL_SCHEME}://open?path=" + urllib.parse.quote(os.path.abspath(folder), safe="")


def decode_open_url(url, home=None):
    """The folder an obsidian-vault-setup://open?path=… link points at, or None when the link is refused.

    The applet's `on open location` handler calls this (via `url --decode`) before acting, so the rules
    live in one tested place: scheme and host must match, the path must be an existing directory under
    the home folder (realpath on both sides, so a symlink cannot escape), and nothing else is honoured.
    A link can come from any app or web page once the scheme is registered, so it is treated as untrusted.
    """
    import urllib.parse
    try:
        p = urllib.parse.urlparse(url)
    except ValueError:
        return None
    if p.scheme != URL_SCHEME or p.netloc != "open":
        return None
    path = urllib.parse.parse_qs(p.query).get("path", [""])[0]
    if not path or "\x00" in path:
        return None
    home_raw = home or HOME
    # A relative path ("dev/project", or "~/dev/project") is under the home folder: the short
    # form the link-bridge /vault-setup page forwards, so a status line link stays readable.
    if path.startswith("~/"):
        path = path[2:]
    if not path.startswith("/"):
        path = os.path.join(home_raw, path)
    path = os.path.realpath(path)
    home = os.path.realpath(home_raw)
    if path.startswith(home + os.sep) and os.path.isdir(path):
        return path
    return None


def cmd_install_finder_button(_args):
    """Build ~/Applications/Open in Obsidian.app from the bundled AppleScript: a Finder toolbar button
    that is also the handler for obsidian-vault-setup://open?path=… links."""
    os.makedirs(os.path.dirname(FINDER_APP), exist_ok=True)
    subprocess.run(["osacompile", "-o", FINDER_APP, FINDER_SCRIPT], check=True)
    icon = "/Applications/Obsidian.app/Contents/Resources/icon.icns"
    if os.path.exists(icon):
        shutil.copyfile(icon, os.path.join(FINDER_APP, "Contents", "Resources", "applet.icns"))
        os.utime(FINDER_APP)
    # Declare the URL scheme in the bundle's Info.plist (osacompile writes a plain applet plist) and
    # tell LaunchServices about it, so `open "obsidian-vault-setup://…"` lands in this app.
    plist = os.path.join(FINDER_APP, "Contents", "Info.plist")
    pb = ["/usr/libexec/PlistBuddy", "-c"]
    subprocess.run(pb + ["Delete :CFBundleURLTypes", plist], stderr=subprocess.DEVNULL)
    for c in ("Add :CFBundleURLTypes array",
              "Add :CFBundleURLTypes:0 dict",
              f"Add :CFBundleURLTypes:0:CFBundleURLName string {URL_SCHEME}",
              "Add :CFBundleURLTypes:0:CFBundleURLSchemes array",
              f"Add :CFBundleURLTypes:0:CFBundleURLSchemes:0 string {URL_SCHEME}"):
        subprocess.run(pb + [c, plist], check=True)
    # osacompile writes no bundle id; LaunchServices keys scheme claims on one, so give it a stable id.
    if subprocess.run(pb + ["Set :CFBundleIdentifier com.johnrandall.open-in-obsidian", plist],
                      stderr=subprocess.DEVNULL).returncode:
        subprocess.run(pb + ["Add :CFBundleIdentifier string com.johnrandall.open-in-obsidian", plist], check=True)
    if os.path.exists(LSREGISTER):
        subprocess.run([LSREGISTER, "-f", FINDER_APP], check=False)
    # osacompile signs the applet ad hoc, so every rebuild changes its code hash and the Automation
    # grant macOS recorded for the previous build no longer matches: the next click fails with
    # "Not authorized to send Apple events to Finder (-1743)" instead of prompting. Clearing the
    # record makes the first click prompt again (2026-10-15).
    subprocess.run(["tccutil", "reset", "AppleEvents", "com.johnrandall.open-in-obsidian"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    print(f"Built {short(FINDER_APP)} (also handles {URL_SCHEME}://open?path=… links).\n"
          "One manual step (Finder has no API for its toolbar): hold Command and drag it from\n"
          "~/Applications into a Finder window's toolbar. Its first click asks to control Finder: click OK.")
    return 0


def cmd_url(args):
    """Print the clickable obsidian-vault-setup:// link for a folder, or with --decode the folder a link
    points at (nothing, exit 1, when the link is refused). The applet's URL handler uses --decode."""
    if args.decode:
        path = decode_open_url(args.folder)
        if path is None:
            return 1
        print(path)
        return 0
    print(open_url(os.path.expanduser(args.folder)))
    return 0


def cmd_forget(args):
    """Unregister a vault from Obsidian's vault list (files untouched). Obsidian refuses while it is open."""
    path = os.path.abspath(os.path.expanduser(args.folder))
    host = next((n for n in [host_vault()] if n and path not in registered_vaults().get(n, set())), None)
    # UNDOCUMENTED-API(vault-remove-ipc): ipcMain.on("vault-remove",(e,path)=>…) — what the vault switcher's
    # "Remove from list" sends. Returns false while the vault has an open window.
    # Fallback: vault switcher -> ••• -> Remove from list.
    result = cli_eval("electron.ipcRenderer.sendSync('vault-remove', %s)" % json.dumps(path), host)
    print(f"forget {short(path)}: {result}" + ("" if result == "true" else " (close its window first)"))
    return 0 if result == "true" else 1


def cmd_apply(args):
    path = os.path.abspath(os.path.expanduser(args.vault))
    return setup(path, args.profile, args.extra, args.register, args.roster)


def cmd_new(args):
    path = os.path.abspath(os.path.expanduser(args.folder))
    return setup(path, default_profile_for(path, args.profile), args.extra, register=True, roster=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=f"obsidian-vault-setup {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("scan", help="read-only: every registered vault, its plugins and pre-flight findings")
    dr = sub.add_parser("doctor", help="probe the CLI and every undocumented API; with a folder, pre-flight it (exit 1 on findings)")
    dr.add_argument("folder", nargs="?", help="a vault folder to pre-flight: unreadable directories, symlinks out of the vault")
    sub.add_parser("install-finder-button", help="build ~/Applications/Open in Obsidian.app (also the obsidian-vault-setup:// URL handler)")
    url = sub.add_parser("url", help="print the clickable obsidian-vault-setup://open?path=… link for a folder")
    url.add_argument("folder", nargs="?", default=".", help="a folder, or with --decode the link")
    url.add_argument("--decode", action="store_true", help="print the folder an obsidian-vault-setup:// link points at; refused links print nothing and exit 1")
    ic = sub.add_parser("init-config", help="create the config file from config.example.yaml")
    ic.add_argument("--force", action="store_true")
    fg = sub.add_parser("forget", help="unregister a closed vault (files untouched)")
    fg.add_argument("folder")
    op = sub.add_parser("open", help="open the vault at the folder's git root, or create it")
    op.add_argument("folder", nargs="?", default=".")
    op.add_argument("--profile", default=None, help="default: review-repo for a watchbill system's home, else core-only")
    op.add_argument("--launch", action="store_true", help="start Obsidian if it is not running (the Finder button and hotkey pass this)")
    op.add_argument("--notify", action="store_true", help="macOS notification with the result")
    new = sub.add_parser("new", help="make a folder a vault, install the whole roster, enable the profile's set")
    new.add_argument("folder", nargs="?", default=".")
    new.add_argument("--profile", default=None, help="default: review-repo for a watchbill system's home, else core-only")
    new.add_argument("--extra", nargs="*", default=[])
    for name in ("plan", "apply"):
        s = sub.add_parser(name)
        s.add_argument("vault")
        s.add_argument("--profile", required=True)
        s.add_argument("--extra", nargs="*", default=[])
        if name == "apply":
            s.add_argument("--register", action="store_true")
            s.add_argument("--roster", action="store_true", help="also install every roster plugin, switched off")
    alias = {"obsidian-new-vault": "new", "obsidian-open-vault": "open"}.get(os.path.basename(sys.argv[0]))
    if alias and (len(sys.argv) < 2 or sys.argv[1] not in ("-h", "--help")):
        sys.argv.insert(1, alias)   # `obsidian-new-vault [folder]` == `obsidian-vault-setup new [folder]`
    args = parser.parse_args()
    sys.exit({"scan": cmd_scan, "doctor": cmd_doctor, "init-config": cmd_init_config, "install-finder-button": cmd_install_finder_button, "url": cmd_url, "forget": cmd_forget, "open": cmd_open, "new": cmd_new, "plan": cmd_plan, "apply": cmd_apply}[args.command](args))


if __name__ == "__main__":
    main()
